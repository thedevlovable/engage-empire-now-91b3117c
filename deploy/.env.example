# Extips Panel — /opt/extips/supabase/docker/.env
# Copy this, then fill every CHANGE_ME. Keys generate karne ke commands neeche hain.
#
#   # POSTGRES_PASSWORD (40 chars, no special chars -> URL-safe)
#   openssl rand -hex 20
#
#   # JWT_SECRET (min 32 chars)
#   openssl rand -hex 32
#
#   # ANON_KEY + SERVICE_ROLE_KEY  (JWT_SECRET se sign hote hain)
#   docker run --rm -e JWT_SECRET="<your-jwt-secret>" node:20-alpine sh -c '
#     npm i -s jsonwebtoken >/dev/null 2>&1
#     node -e "
#       const jwt=require(\"jsonwebtoken\");
#       const s=process.env.JWT_SECRET;
#       const iat=Math.floor(Date.now()/1000), exp=iat+60*60*24*365*10;
#       console.log(\"ANON_KEY=\"+jwt.sign({role:\"anon\",iss:\"supabase\",iat,exp},s));
#       console.log(\"SERVICE_ROLE_KEY=\"+jwt.sign({role:\"service_role\",iss:\"supabase\",iat,exp},s));
#     "'

############ CORE ############
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
SECRET_KEY_BASE=CHANGE_ME          # openssl rand -hex 32
VAULT_ENC_KEY=CHANGE_ME            # openssl rand -hex 16

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############ URLS (naya domain) ############
SITE_URL=https://panel.example.com
API_EXTERNAL_URL=https://api.panel.example.com
SUPABASE_PUBLIC_URL=https://api.panel.example.com
ADDITIONAL_REDIRECT_URLS=https://panel.example.com

############ AUTH — signup: sirf name+email+password, email verify OFF ############
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
JWT_EXPIRY=3600
MAILER_URLPATHS_CONFIRMATION=/auth/confirm
MAILER_URLPATHS_INVITE=/auth/confirm
MAILER_URLPATHS_RECOVERY=/auth/reset
MAILER_URLPATHS_EMAIL_CHANGE=/auth/confirm

############ SMTP (optional; autoconfirm ON hai to zaroori nahi) ############
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Extips Panel

############ STUDIO / DASHBOARD ############
STUDIO_DEFAULT_ORGANIZATION=Extips
STUDIO_DEFAULT_PROJECT=ExtipsPanel
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME
STUDIO_PORT=3000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############ ANALYTICS / POOLER ############
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
POOLER_TENANT_ID=extips
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=200
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DB_POOL_SIZE=10

############ EDGE FUNCTION SECRETS (app-specific) ############
# Ye wahi naam hain jo functions ke code me Deno.env.get() karte hain.
SUPABASE_URL=https://api.panel.example.com
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
SUPABASE_DB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/postgres

ZAPUPI_TOKEN_KEY=CHANGE_ME
ZAPUPI_SECRET_KEY=CHANGE_ME
OXAPAY_MERCHANT_API_KEY=CHANGE_ME
OXAPAY_PAYOUT_API_KEY=
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME
RESEND_API_KEY=
INTERNAL_CRON_TOKEN=CHANGE_ME      # openssl rand -hex 24
